# Demo mode is enabled by default. Set to live only after configuring verified Shopflow/MoySklad adapters.
MOYSKLAD_MODE=mock
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_CURRENCY=UZS

# Shopflow Public API v1 (verified): catalog proxies + order creation + webhooks.
SHOPFLOW_API_URL=
SHOPFLOW_API_KEY=
SHOPFLOW_WEBHOOK_SECRET=
SHOPFLOW_STOREFRONT_URL=
# MoySklad JSON API 1.2 (verified counterparty subset only). Pre-mint ONE token
# (minting revokes older tokens) and paste it here; enables Telegram bot
# identification. Catalog/sales history for live mode is still unverified —
# keep MOYSKLAD_MODE=mock. See MOYSKLAD_INTEGRATION.md.
MOYSKLAD_API_TOKEN=

# Telegram reminders (server-only; never use NEXT_PUBLIC_* for these).
# Keep disabled until the bot, webhook, scheduler, Shopflow auth and durable
# Telegram storage are all configured. See TELEGRAM_SETUP.md.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINKING_SECRET=
TELEGRAM_CRON_SECRET=
TELEGRAM_ADMIN_SECRET=
# Optional: your numeric Telegram chat id for new-application notifications.
TELEGRAM_ADMIN_CHAT_ID=
# Local dry runs with a fake sender only; never enable with a real bot token.
TELEGRAM_STORE_MODE=
# Admin login wall: /admin + /api/admin require this password (min 12 chars).
# Server-only secret — never commit the real value. Rotate = everyone logged out.
ADMIN_PASSWORD=
