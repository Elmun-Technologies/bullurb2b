# Demo mode is enabled by default. Set to live only after configuring verified Shopflow/MoySklad adapters.
MOYSKLAD_MODE=mock
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_CURRENCY=UZS

# No Shopflow or MoySklad SDK/config exists in this repository yet.
# Configure only after confirming the actual provider API/auth contract.
SHOPFLOW_API_URL=
SHOPFLOW_API_KEY=
MOYSKLAD_API_TOKEN=
MOYSKLAD_ACCOUNT_ID=
